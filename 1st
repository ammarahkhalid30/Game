<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Learn Adding with Sam the Stickman</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Comic Sans MS", "Chalkboard SE", cursive, sans-serif;
  }

  body {
    min-height: 100vh;
    background: linear-gradient(180deg, #a8e6ff 0%, #fff3b0 60%, #90ee90 60%, #7cd47c 100%);
    padding: 15px;
    color: #2d3436;
  }

  .app {
    max-width: 900px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 25px;
    padding: 20px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
  }

  h1 {
    text-align: center;
    color: #6c5ce7;
    font-size: 2em;
    margin-bottom: 15px;
  }

  h2 {
    text-align: center;
    color: #e17055;
    margin-bottom: 15px;
  }

  /* MENU */
  .menu_grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 12px;
    margin: 20px 0;
  }

  .sum_btn {
    background: linear-gradient(135deg, #74b9ff, #0984e3);
    color: white;
    border: none;
    padding: 20px;
    font-size: 1.5em;
    font-weight: bold;
    border-radius: 15px;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 5px 12px rgba(9,132,227,0.3);
    transition: transform 0.15s;
  }

  .sum_btn:hover {
    transform: translateY(3px);
  }

  .quiz_btn {
    display: block;
    margin: 20px auto;
    background: linear-gradient(135deg, #fd79a8, #e84393);
    color: white;
    border: none;
    padding: 18px 40px;
    font-size: 1.3em;
    font-weight: bold;
    border-radius: 30px;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 5px 15px rgba(232,67,147,0.4);
  }

  /* STAGE */
  .stage {
    position: relative;
    min-height: 380px;
    background: linear-gradient(180deg, #e3f2fd 0%, #fff9c4 70%, #c8e6c9 70%, #a5d6a7 100%);
    border-radius: 20px;
    overflow: hidden;
    margin: 15px 0;
  }

  .stickman_area {
    position: relative;
    width: 100%;
    height: 320px;
  }

  #stickmanSvg {
    display: block;
    margin: 0 auto;
  }

  .speech {
    position: absolute;
    top: 20px;
    right: 15px;
    max-width: 260px;
    background: white;
    border: 3px solid #6c5ce7;
    border-radius: 20px;
    padding: 12px 15px;
    font-size: 1.05em;
    line-height: 1.4;
    box-shadow: 3px 3px 0 rgba(108,92,231,0.3);
    z-index: 5;
  }

  .speech::after {
    content: "";
    position: absolute;
    bottom: 20px;
    left: -15px;
    border-width: 10px;
    border-style: solid;
    border-color: transparent #6c5ce7 transparent transparent;
  }

  .speech::before {
    content: "";
    position: absolute;
    bottom: 22px;
    left: -10px;
    border-width: 8px;
    border-style: solid;
    border-color: transparent white transparent transparent;
    z-index: 1;
  }

  /* VISUAL AREA below stickman */
  .visual_area {
    padding: 15px;
    background: #fff8e1;
    border-radius: 15px;
    margin-top: 10px;
    min-height: 100px;
    text-align: center;
  }

  .compare_row {
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }

  .compare_group {
    background: white;
    border: 3px solid #dfe6e9;
    border-radius: 15px;
    padding: 12px;
    min-width: 140px;
    transition: all 0.3s;
  }

  .compare_group.winner {
    border-color: #00b894;
    background: #d4f5e9;
    transform: scale(1.08);
    box-shadow: 0 5px 15px rgba(0,184,148,0.3);
  }

  .compare_group .label {
    font-size: 1.5em;
    font-weight: bold;
    color: #2d3436;
    margin-bottom: 8px;
  }

  .compare_group .dots {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: center;
    max-width: 150px;
  }

  .dot {
    width: 22px;
    height: 22px;
    background: #ff7675;
    border-radius: 50%;
    box-shadow: inset 2px 2px 4px rgba(0,0,0,0.2);
    animation: dropIn 0.4s ease;
  }

  .compare_group.winner .dot {
    background: #00b894;
  }

  @keyframes dropIn {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* Count on display */
  .count_track {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 1.4em;
    font-weight: bold;
    color: #2d3436;
    margin-top: 10px;
  }

  .count_chip {
    background: #ffeaa7;
    border: 2px solid #fdcb6e;
    border-radius: 12px;
    padding: 6px 12px;
    min-width: 40px;
    animation: chipPop 0.4s ease;
  }

  .count_chip.new {
    background: #55efc4;
    border-color: #00b894;
    color: white;
    animation: chipPop 0.4s ease, glow 0.6s ease;
  }

  @keyframes chipPop {
    0% { transform: scale(0); }
    60% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  @keyframes glow {
    0%, 100% { box-shadow: 0 0 0 rgba(0,184,148,0); }
    50% { box-shadow: 0 0 20px rgba(0,184,148,0.8); }
  }

  .final_answer {
    font-size: 2em;
    color: #d63031;
    font-weight: bold;
    margin-top: 10px;
    animation: bounce 0.6s ease;
  }

  @keyframes bounce {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }

  /* Controls */
  .controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 15px;
    flex-wrap: wrap;
  }

  .ctrl_btn {
    padding: 12px 25px;
    font-size: 1.1em;
    font-weight: bold;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    font-family: inherit;
    color: white;
    transition: transform 0.15s;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }

  .ctrl_btn:hover {
    transform: translateY(2px);
  }

  .btn_next {
    background: linear-gradient(135deg, #00b894, #00cec9);
  }

  .btn_back {
    background: linear-gradient(135deg, #636e72, #2d3436);
  }

  .btn_replay {
    background: linear-gradient(135deg, #fdcb6e, #e17055);
  }

  /* Quiz */
  .quiz_card {
    background: linear-gradient(135deg, #ffeaa7, #fab1a0);
    padding: 25px;
    border-radius: 20px;
    text-align: center;
    margin: 15px 0;
  }

  .quiz_question {
    font-size: 2.5em;
    font-weight: bold;
    color: #2d3436;
    margin: 20px 0;
  }

  .quiz_options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 400px;
    margin: 0 auto;
  }

  .quiz_opt {
    padding: 20px;
    font-size: 1.8em;
    font-weight: bold;
    border: none;
    border-radius: 15px;
    cursor: pointer;
    font-family: inherit;
    background: white;
    color: #2d3436;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    transition: transform 0.15s;
  }

  .quiz_opt:hover:not(:disabled) {
    transform: translateY(2px);
  }

  .quiz_opt.right {
    background: #00b894;
    color: white;
  }

  .quiz_opt.wrong {
    background: #d63031;
    color: white;
  }

  .quiz_opt:disabled {
    cursor: not-allowed;
    opacity: 0.85;
  }

  .quiz_score {
    text-align: center;
    font-size: 1.4em;
    font-weight: bold;
    color: #6c5ce7;
    margin: 15px 0;
  }

  .quiz_feedback {
    text-align: center;
    font-size: 1.3em;
    font-weight: bold;
    margin: 15px 0;
    min-height: 30px;
  }

  .hidden { display: none; }

  /* Stickman animations */
  .bobbing {
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .thought_bubble {
    animation: floaty 3s ease-in-out infinite;
  }

  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  /* Progress dots */
  .progress {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 10px 0;
  }

  .prog_dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #dfe6e9;
  }

  .prog_dot.active {
    background: #6c5ce7;
  }

  .prog_dot.done {
    background: #00b894;
  }

  @media (max-width: 600px) {
    h1 { font-size: 1.5em; }
    .speech {
      max-width: 180px;
      font-size: 0.9em;
      padding: 10px;
    }
    .quiz_question { font-size: 2em; }
    .quiz_opt { font-size: 1.5em; padding: 15px; }
  }
</style>
</head>
<body>

<div class="app">

  <!-- MENU SCREEN -->
  <div id="menuScreen">
    <h1>👋 Meet Sam the Stickman!</h1>
    <p style="text-align:center; font-size:1.1em; margin:10px 0;">
      Sam will show you a smart way to add numbers.<br>
      Pick a sum to see how Sam does it!
    </p>
    <div class="menu_grid" id="menuGrid"></div>
    <button class="quiz_btn" onclick="startQuiz()">🎯 Try the Quiz</button>
  </div>

  <!-- LESSON SCREEN -->
  <div id="lessonScreen" class="hidden">
    <h2 id="lessonTitle"></h2>
    <div class="progress" id="progressDots"></div>

    <div class="stage">
      <div class="stickman_area">
        <div class="speech" id="speechBubble">Hi there!</div>
        <svg id="stickmanSvg" viewBox="0 0 400 320" width="100%" height="320">
          <!-- Stickman will be drawn here -->
        </svg>
      </div>
    </div>

    <div class="visual_area" id="visualArea">
      <p style="color:#636e72;">Watch what Sam does...</p>
    </div>

    <div class="controls">
      <button class="ctrl_btn btn_back" onclick="goToMenu()">🏠 Menu</button>
      <button class="ctrl_btn btn_replay" onclick="replayLesson()">🔁 Replay</button>
      <button class="ctrl_btn btn_next" id="nextStepBtn" onclick="nextStep()">Next ➡</button>
    </div>
  </div>

  <!-- QUIZ SCREEN -->
  <div id="quizScreen" class="hidden">
    <h2>🎯 Quiz Time with Sam!</h2>
    <div class="quiz_score" id="quizScore">Score: 0 out of 0</div>

    <div class="stage" style="min-height:220px;">
      <div class="stickman_area" style="height:200px;">
        <div class="speech" id="quizSpeech">Can you help me solve this one?</div>
        <svg id="quizStickmanSvg" viewBox="0 0 400 200" width="100%" height="200"></svg>
      </div>
    </div>

    <div class="quiz_card">
      <div class="quiz_question" id="quizQuestion">3 + 4 = ?</div>
      <div class="quiz_options" id="quizOptions"></div>
      <div class="quiz_feedback" id="quizFeedback"></div>
    </div>

    <div class="controls">
      <button class="ctrl_btn btn_back" onclick="goToMenu()">🏠 Menu</button>
      <button class="ctrl_btn btn_next hidden" id="nextQuizBtn" onclick="nextQuizQuestion()">Next Question ➡</button>
    </div>
  </div>

</div>

<script>
  // Sums list for the menu
  const sums = [
    {a: 9, b: 1}, {a: 7, b: 8}, {a: 6, b: 7}, {a: 2, b: 4},
    {a: 5, b: 2}, {a: 3, b: 6}, {a: 4, b: 5}, {a: 8, b: 3},
    {a: 5, b: 5}, {a: 4, b: 7}, {a: 2, b: 9}, {a: 6, b: 3}
  ];

  // Lesson state
  let current = null;
  let stepIndex = 0;
  let totalSteps = 6;

  // Build the menu
  function buildMenu() {
    const grid = document.getElementById("menuGrid");
    grid.innerHTML = "";
    sums.forEach(s => {
      const btn = document.createElement("button");
      btn.className = "sum_btn";
      btn.textContent = s.a + " + " + s.b;
      btn.onclick = () => startLesson(s);
      grid.appendChild(btn);
    });
  }

  // Draw stickman with optional thought bubble and hand fingers
  function drawStickman(svg, opts) {
    opts = opts || {};
    const thought = opts.thought;
    const fingers = opts.fingers || 0;
    const mood = opts.mood || "smile";
    const pointing = opts.pointing || false;

    let html = "";

    // Ground line
    html += '<line x1="20" y1="280" x2="380" y2="280" stroke="#8b6f47" stroke-width="3" stroke-dasharray="5,5"/>';

    // Thought bubble
    if (thought !== undefined && thought !== null) {
      html += '<g class="thought_bubble">';
      // Little bubbles leading up
      html += '<circle cx="90" cy="90" r="5" fill="white" stroke="#6c5ce7" stroke-width="2"/>';
      html += '<circle cx="80" cy="75" r="7" fill="white" stroke="#6c5ce7" stroke-width="2"/>';
      // Main cloud
      html += '<ellipse cx="70" cy="50" rx="55" ry="35" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      html += '<circle cx="35" cy="45" r="18" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      html += '<circle cx="105" cy="45" r="18" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      html += '<circle cx="55" cy="30" r="15" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      html += '<circle cx="85" cy="30" r="15" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      // Cover inner strokes
      html += '<ellipse cx="70" cy="50" rx="50" ry="30" fill="white"/>';
      // Number inside
      html += '<text x="70" y="62" text-anchor="middle" font-size="36" font-weight="bold" fill="#6c5ce7" font-family="Comic Sans MS, cursive">' + thought + '</text>';
      html += '</g>';
    }

    // Stickman group
    html += '<g class="bobbing">';

    // Head
    html += '<circle cx="200" cy="130" r="28" fill="#ffe0b2" stroke="#2d3436" stroke-width="3"/>';

    // Eyes
    html += '<circle cx="192" cy="125" r="3" fill="#2d3436"/>';
    html += '<circle cx="208" cy="125" r="3" fill="#2d3436"/>';

    // Mouth based on mood
    if (mood === "smile") {
      html += '<path d="M 188 138 Q 200 148 212 138" stroke="#2d3436" stroke-width="2.5" fill="none" stroke-linecap="round"/>';
    } else if (mood === "excited") {
      html += '<ellipse cx="200" cy="142" rx="8" ry="6" fill="#d63031"/>';
    } else if (mood === "thinking") {
      html += '<line x1="192" y1="142" x2="208" y2="142" stroke="#2d3436" stroke-width="2.5" stroke-linecap="round"/>';
    }

    // Body
    html += '<line x1="200" y1="158" x2="200" y2="230" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';

    // Left arm (always down and relaxed)
    html += '<line x1="200" y1="175" x2="165" y2="215" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';

    // Right arm and hand with fingers
    if (fingers > 0) {
      // Raised arm
      html += '<line x1="200" y1="175" x2="250" y2="130" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
      // Draw hand with fingers
      html += drawHand(250, 130, fingers);
    } else if (pointing) {
      // Pointing arm
      html += '<line x1="200" y1="175" x2="245" y2="160" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
      html += '<circle cx="250" cy="160" r="8" fill="#ffe0b2" stroke="#2d3436" stroke-width="2"/>';
      html += '<line x1="255" y1="160" x2="275" y2="160" stroke="#2d3436" stroke-width="3" stroke-linecap="round"/>';
    } else {
      // Normal arm down
      html += '<line x1="200" y1="175" x2="235" y2="215" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
    }

    // Legs
    html += '<line x1="200" y1="230" x2="175" y2="278" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
    html += '<line x1="200" y1="230" x2="225" y2="278" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';

    html += '</g>';

    svg.innerHTML = html;
  }

  // Draw a hand with N fingers up. If more than 5, add a second hand.
  function drawHand(centerX, centerY, count) {
    let h = "";
    const firstHand = Math.min(count, 5);
    const secondHand = count > 5 ? count - 5 : 0;

    // Draw main hand
    h += drawSingleHand(centerX, centerY, firstHand, false);

    // Draw second hand to the right if needed
    if (secondHand > 0) {
      h += drawSingleHand(centerX + 60, centerY + 5, secondHand, true);
    }
    return h;
  }

  function drawSingleHand(cx, cy, upCount, mirrored) {
    let h = "";
    // Palm
    h += '<ellipse cx="' + cx + '" cy="' + (cy + 15) + '" rx="22" ry="18" fill="#ffe0b2" stroke="#2d3436" stroke-width="2"/>';

    // 5 finger positions relative to palm
    // Fingers arranged along top of palm
    const fingerPositions = [
      {x: -14, y: -5, h: 22},  // pinky
      {x: -5, y: -8, h: 28},   // ring
      {x: 5, y: -8, h: 30},    // middle
      {x: 14, y: -5, h: 26},   // index
    ];
    // Thumb sticks out to the side
    const thumb = {x: mirrored ? 22 : -22, y: 8, h: 18};

    // Fingers 1 to 4 are the four fingers, finger 5 is the thumb
    for (let i = 0; i < 4; i++) {
      const fp = fingerPositions[i];
      const isUp = i < upCount;
      const fx = cx + fp.x;
      const fy = cy + fp.y;
      if (isUp) {
        // Full finger going up
        h += '<rect x="' + (fx - 4) + '" y="' + (fy - fp.h) + '" width="8" height="' + fp.h + '" rx="4" fill="#ffe0b2" stroke="#2d3436" stroke-width="2"/>';
      } else {
        // Down finger, small nub
        h += '<circle cx="' + fx + '" cy="' + fy + '" r="4" fill="#ffcc80" stroke="#2d3436" stroke-width="1.5"/>';
      }
    }

    // Thumb (finger 5)
    const thumbUp = upCount >= 5;
    if (thumbUp) {
      const tx = cx + thumb.x;
      const ty = cy + thumb.y;
      h += '<rect x="' + (tx - 4) + '" y="' + (ty - thumb.h/2) + '" width="8" height="' + thumb.h + '" rx="4" fill="#ffe0b2" stroke="#2d3436" stroke-width="2" transform="rotate(' + (mirrored ? 60 : -60) + ' ' + tx + ' ' + ty + ')"/>';
    }

    return h;
  }

  // LESSON FLOW
  function startLesson(sum) {
    document.getElementById("menuScreen").classList.add("hidden");
    document.getElementById("quizScreen").classList.add("hidden");
    document.getElementById("lessonScreen").classList.remove("hidden");

    current = sum;
    stepIndex = 0;

    const bigger = Math.max(sum.a, sum.b);
    const smaller = Math.min(sum.a, sum.b);
    current.bigger = bigger;
    current.smaller = smaller;
    current.answer = sum.a + sum.b;

    document.getElementById("lessonTitle").textContent = "Sam is solving " + sum.a + " + " + sum.b;
    buildProgressDots();
    showStep();
  }

  function buildProgressDots() {
    const dots = document.getElementById("progressDots");
    dots.innerHTML = "";
    for (let i = 0; i < totalSteps; i++) {
      const d = document.createElement("div");
      d.className = "prog_dot";
      if (i < stepIndex) d.classList.add("done");
      if (i === stepIndex) d.classList.add("active");
      dots.appendChild(d);
    }
  }

  function showStep() {
    buildProgressDots();
    const svg = document.getElementById("stickmanSvg");
    const speech = document.getElementById("speechBubble");
    const visual = document.getElementById("visualArea");
    const nextBtn = document.getElementById("nextStepBtn");

    const {a, b, bigger, smaller, answer} = current;

    if (stepIndex === 0) {
      // Step 1: Introduce the problem
      speech.innerHTML = "Hmm, I need to add <b>" + a + " plus " + b + "</b>. Let me think how to do it!";
      drawStickman(svg, {mood: "thinking"});
      visual.innerHTML = '<div style="font-size:2em; font-weight:bold; color:#2d3436;">' + a + ' + ' + b + ' = ?</div>';
      nextBtn.textContent = "Next ➡";
    }
    else if (stepIndex === 1) {
      // Step 2: Compare which is bigger
      speech.innerHTML = "First I check, which number is bigger? Let me count the dots!";
      drawStickman(svg, {mood: "thinking", pointing: true});
      visual.innerHTML = buildCompareView(a, b, false);
      nextBtn.textContent = "Which is bigger?";
    }
    else if (stepIndex === 2) {
      // Step 3: Show bigger side wins
      speech.innerHTML = "Yes! <b>" + bigger + "</b> is the bigger number. I will keep it in my mind!";
      drawStickman(svg, {mood: "excited", pointing: true});
      visual.innerHTML = buildCompareView(a, b, true);
      nextBtn.textContent = "Put it in mind";
    }
    else if (stepIndex === 3) {
      // Step 4: Put bigger in thought bubble
      speech.innerHTML = "I put <b>" + bigger + "</b> in my mind. Now I need to add <b>" + smaller + "</b> more.";
      drawStickman(svg, {mood: "smile", thought: bigger});
      visual.innerHTML = '<p style="font-size:1.2em;">Sam is holding <b>' + bigger + '</b> in his head 🧠</p>' +
        '<p style="font-size:1.1em; margin-top:10px;">Now he needs to add <b>' + smaller + '</b> more.</p>';
      nextBtn.textContent = "Show fingers";
    }
    else if (stepIndex === 4) {
      // Step 5: Show fingers for smaller number
      speech.innerHTML = "I put up <b>" + smaller + "</b> " + (smaller === 1 ? "finger" : "fingers") + " on my hand. One for each number I still have to add.";
      drawStickman(svg, {mood: "smile", thought: bigger, fingers: smaller});
      visual.innerHTML = '<p style="font-size:1.15em;">Sam has <b>' + bigger + '</b> in his mind and <b>' + smaller + '</b> ' +
        (smaller === 1 ? "finger" : "fingers") + ' up.</p>' +
        '<p style="font-size:1.05em; margin-top:8px; color:#636e72;">Next he will count on from ' + bigger + '.</p>';
      nextBtn.textContent = "Start counting!";
    }
    else if (stepIndex === 5) {
      // Step 6: Count on and reveal answer
      speech.innerHTML = "I already have <b>" + bigger + "</b>. So I count on: " + buildCountingText(bigger, smaller) + ". The answer is <b>" + answer + "</b>!";
      drawStickman(svg, {mood: "excited", thought: answer, fingers: smaller});
      visual.innerHTML = buildCountOnView(bigger, smaller, answer);
      nextBtn.textContent = "🏁 Try another!";
    }
    else {
      // Done
      goToMenu();
    }
  }

  function buildCompareView(a, b, highlightBigger) {
    let html = '<div class="compare_row">';
    const groups = [{n: a, label: a}, {n: b, label: b}];
    groups.forEach(g => {
      const isWinner = highlightBigger && g.n === Math.max(a, b) && a !== b;
      html += '<div class="compare_group' + (isWinner ? ' winner' : '') + '">';
      html += '<div class="label">' + g.label + '</div>';
      html += '<div class="dots">';
      for (let i = 0; i < g.n; i++) {
        html += '<div class="dot" style="animation-delay:' + (i * 0.05) + 's;"></div>';
      }
      html += '</div>';
      if (isWinner) html += '<div style="margin-top:8px; font-size:1.2em;">👑 Bigger!</div>';
      html += '</div>';
    });
    html += '</div>';
    if (a === b && highlightBigger) {
      html += '<p style="margin-top:12px; font-size:1.1em; color:#6c5ce7;">They are the same! Either one can go in the mind.</p>';
    }
    return html;
  }

  function buildCountingText(bigger, smaller) {
    let parts = [];
    for (let i = 1; i <= smaller; i++) {
      parts.push(bigger + i);
    }
    return parts.join(", ");
  }

  function buildCountOnView(bigger, smaller, answer) {
    let html = '<p style="font-size:1.1em; margin-bottom:10px;">Start at <b>' + bigger + '</b> and count on <b>' + smaller + '</b> more:</p>';
    html += '<div class="count_track">';
    html += '<div class="count_chip">' + bigger + '</div>';
    html += '<div style="font-size:1.5em;">➡</div>';
    for (let i = 1; i <= smaller; i++) {
      html += '<div class="count_chip new" style="animation-delay:' + (0.3 + i * 0.3) + 's;">' + (bigger + i) + '</div>';
    }
    html += '</div>';
    html += '<div class="final_answer">' + bigger + ' + ' + smaller + ' = ' + answer + ' 🎉</div>';
    return html;
  }

  function nextStep() {
    stepIndex++;
    if (stepIndex >= totalSteps) {
      goToMenu();
    } else {
      showStep();
    }
  }

  function replayLesson() {
    stepIndex = 0;
    showStep();
  }

  function goToMenu() {
    document.getElementById("lessonScreen").classList.add("hidden");
    document.getElementById("quizScreen").classList.add("hidden");
    document.getElementById("menuScreen").classList.remove("hidden");
  }

  // QUIZ MODE
  let quizQuestions = [];
  let quizIndex = 0;
  let quizCorrect = 0;
  let quizAnswered = false;

  function buildQuizQuestions() {
    // Pick 5 random sums (all within 20)
    const pool = [];
    for (let x = 1; x <= 10; x++) {
      for (let y = 1; y <= 10; y++) {
        if (x + y <= 20) pool.push({a: x, b: y});
      }
    }
    // Shuffle and pick 5
    pool.sort(() => Math.random() - 0.5);
    quizQuestions = pool.slice(0, 5);
    quizIndex = 0;
    quizCorrect = 0;
  }

  function startQuiz() {
    document.getElementById("menuScreen").classList.add("hidden");
    document.getElementById("lessonScreen").classList.add("hidden");
    document.getElementById("quizScreen").classList.remove("hidden");

    buildQuizQuestions();
    showQuizQuestion();
  }

  function showQuizQuestion() {
    quizAnswered = false;
    const q = quizQuestions[quizIndex];
    const answer = q.a + q.b;

    document.getElementById("quizScore").textContent = "Question " + (quizIndex + 1) + " of " + quizQuestions.length + "   |   Score: " + quizCorrect;
    document.getElementById("quizQuestion").textContent = q.a + " + " + q.b + " = ?";
    document.getElementById("quizFeedback").textContent = "";
    document.getElementById("nextQuizBtn").classList.add("hidden");

    const bigger = Math.max(q.a, q.b);
    const smaller = Math.min(q.a, q.b);
    document.getElementById("quizSpeech").innerHTML = "Remember: put <b>" + bigger + "</b> in your mind and count on <b>" + smaller + "</b> more!";

    // Draw a smaller stickman for quiz
    const svg = document.getElementById("quizStickmanSvg");
    drawQuizStickman(svg, {mood: "thinking", thought: bigger});

    // Build answer options
    const opts = new Set();
    opts.add(answer);
    while (opts.size < 4) {
      const wrong = answer + Math.floor(Math.random() * 7) - 3;
      if (wrong > 0 && wrong <= 20 && wrong !== answer) opts.add(wrong);
    }
    const arr = Array.from(opts).sort(() => Math.random() - 0.5);
    const optsDiv = document.getElementById("quizOptions");
    optsDiv.innerHTML = "";
    arr.forEach(v => {
      const b = document.createElement("button");
      b.className = "quiz_opt";
      b.textContent = v;
      b.onclick = () => checkQuizAnswer(b, v, answer, bigger, smaller);
      optsDiv.appendChild(b);
    });
  }

  function drawQuizStickman(svg, opts) {
    // Compact version scaled down
    opts = opts || {};
    const thought = opts.thought;
    const mood = opts.mood || "smile";
    let html = "";

    if (thought !== undefined) {
      html += '<g class="thought_bubble">';
      html += '<circle cx="90" cy="80" r="4" fill="white" stroke="#6c5ce7" stroke-width="2"/>';
      html += '<circle cx="82" cy="68" r="6" fill="white" stroke="#6c5ce7" stroke-width="2"/>';
      html += '<ellipse cx="70" cy="45" rx="45" ry="28" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      html += '<circle cx="40" cy="42" r="15" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      html += '<circle cx="100" cy="42" r="15" fill="white" stroke="#6c5ce7" stroke-width="3"/>';
      html += '<ellipse cx="70" cy="45" rx="40" ry="23" fill="white"/>';
      html += '<text x="70" y="55" text-anchor="middle" font-size="26" font-weight="bold" fill="#6c5ce7">' + thought + '</text>';
      html += '</g>';
    }

    html += '<g class="bobbing">';
    html += '<circle cx="200" cy="80" r="22" fill="#ffe0b2" stroke="#2d3436" stroke-width="3"/>';
    html += '<circle cx="193" cy="76" r="2.5" fill="#2d3436"/>';
    html += '<circle cx="207" cy="76" r="2.5" fill="#2d3436"/>';
    if (mood === "thinking") {
      html += '<line x1="193" y1="90" x2="207" y2="90" stroke="#2d3436" stroke-width="2" stroke-linecap="round"/>';
    } else {
      html += '<path d="M 190 88 Q 200 96 210 88" stroke="#2d3436" stroke-width="2.5" fill="none" stroke-linecap="round"/>';
    }
    html += '<line x1="200" y1="102" x2="200" y2="160" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
    html += '<line x1="200" y1="118" x2="170" y2="150" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
    html += '<line x1="200" y1="118" x2="230" y2="150" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
    html += '<line x1="200" y1="160" x2="180" y2="195" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
    html += '<line x1="200" y1="160" x2="220" y2="195" stroke="#2d3436" stroke-width="4" stroke-linecap="round"/>';
    html += '</g>';

    svg.innerHTML = html;
  }

  function checkQuizAnswer(btn, chosen, correct, bigger, smaller) {
    if (quizAnswered) return;
    quizAnswered = true;

    const allBtns = document.querySelectorAll(".quiz_opt");
    allBtns.forEach(b => b.disabled = true);

    const feedback = document.getElementById("quizFeedback");
    const speech = document.getElementById("quizSpeech");
    const svg = document.getElementById("quizStickmanSvg");

    if (chosen === correct) {
      quizCorrect++;
      btn.classList.add("right");
      const msgs = ["Fantastic!", "You got it!", "Well done!", "Super!", "Amazing work!"];
      feedback.textContent = "🎉 " + msgs[Math.floor(Math.random() * msgs.length)];
      feedback.style.color = "#00b894";
      speech.innerHTML = "Yay! <b>" + correct + "</b> is right!";
      drawQuizStickman(svg, {mood: "smile", thought: correct});
    } else {
      btn.classList.add("wrong");
      allBtns.forEach(b => {
        if (parseInt(b.textContent) === correct) b.classList.add("right");
      });
      feedback.textContent = "The right answer was " + correct + ". Keep trying!";
      feedback.style.color = "#d63031";
      speech.innerHTML = "The answer is <b>" + correct + "</b>. Put " + bigger + " in your mind and count on " + smaller + ".";
    }

    if (quizIndex < quizQuestions.length - 1) {
      document.getElementById("nextQuizBtn").classList.remove("hidden");
      document.getElementById("nextQuizBtn").textContent = "Next Question ➡";
    } else {
      document.getElementById("nextQuizBtn").classList.remove("hidden");
      document.getElementById("nextQuizBtn").textContent = "See Result 🏆";
    }
  }

  function nextQuizQuestion() {
    quizIndex++;
    if (quizIndex >= quizQuestions.length) {
      showQuizResult();
    } else {
      showQuizQuestion();
    }
  }

  function showQuizResult() {
    const total = quizQuestions.length;
    let message, emoji;
    if (quizCorrect === total) {
      message = "Perfect score! You are a math star!";
      emoji = "🏆⭐🏆";
    } else if (quizCorrect >= total * 0.6) {
      message = "Great job! You really got the hang of it.";
      emoji = "🌟🎉";
    } else {
      message = "Nice try! Watch Sam again and give it another go.";
      emoji = "💪";
    }

    document.getElementById("quizQuestion").innerHTML = emoji;
    document.getElementById("quizOptions").innerHTML = '<div style="grid-column: span 2; font-size:1.4em; font-weight:bold; color:#6c5ce7;">You got ' + quizCorrect + ' out of ' + total + ' right!</div>';
    document.getElementById("quizFeedback").textContent = message;
    document.getElementById("quizFeedback").style.color = "#2d3436";
    document.getElementById("quizScore").textContent = "Quiz finished!";
    document.getElementById("quizSpeech").innerHTML = "Great work! Want to try again?";

    const btn = document.getElementById("nextQuizBtn");
    btn.textContent = "🔁 Play Again";
    btn.onclick = startQuiz;
  }

  // Initialize
  buildMenu();
</script>

</body>
</html>
